# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/vervemarket

# Authentication & Security
JWT_ACCESS_SECRET=vervemarket_jwt_access_secret_key_super_secure_32_chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=vervemarket_jwt_refresh_secret_key_super_secure_32_chars!
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Redis Cache / Rate Limit (Optional - falls back to memory if unreachable)
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# File Storage / Cloudinary
CLOUDINARY_CLOUD_NAME=vervemarket_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment Gateway (Mock / Sandbox)
PAYMENT_GATEWAY_KEY=mock_payment_key_12345
PAYMENT_GATEWAY_SECRET=mock_payment_secret_67890
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_abcde
